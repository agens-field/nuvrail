# Copy to .env and fill in values. Never commit .env.

# ---------------------------------------------------------------------------
# Data directory
# ---------------------------------------------------------------------------
NUVRAIL_DATA_DIR=/data

# Milliseconds a SQLite connection waits for another process's write lock
# before failing with 'database is locked'. The IMAP proxy, SMTP proxy, REST
# API, and background loops all share one SQLite file (WAL mode), so writers
# must wait rather than error. Raise if you see lock errors under heavy load.
NUVRAIL_SQLITE_BUSY_TIMEOUT_MS=5000

# Largest IMAP APPEND body (bytes) persisted for replay on approval. Messages
# above this are still accepted from the agent but staged without a body and
# will not be re-appended upstream. Default 10 MiB.
NUVRAIL_MAX_APPEND_BYTES=10485760

# ---------------------------------------------------------------------------
# Encryption
# ---------------------------------------------------------------------------
# Master key for AES-256-GCM upstream credential encryption.
# Must be exactly 64 hex characters (32 bytes). Required for production.
# Generate with: python3 -c "import secrets; print(secrets.token_bytes(32).hex())"
# WARNING: losing this key makes all stored upstream credentials unrecoverable.
# If unset, a key is auto-generated to NUVRAIL_DATA_DIR/master.key (dev only).
# NOTE: the master key is only used by the `local` secret backend below (and to
# decrypt any not-yet-migrated rows). It is NOT used when secrets live in a
# cloud secret manager.
NUVRAIL_MASTER_KEY=

# ---------------------------------------------------------------------------
# Secret backend (where long-lived credentials are stored at rest)
# ---------------------------------------------------------------------------
# local  → AES-256-GCM in the DB using NUVRAIL_MASTER_KEY (default)
# aws-sm → AWS Secrets Manager (requires the [aws] extra: aioboto3)
# gcp-sm → GCP Secret Manager (requires the [gcp] extra: google-cloud-secret-manager)
#
# With aws-sm/gcp-sm, only a reference (ARN / resource path) is stored in the DB;
# the secret itself lives in the manager and is fetched on demand into a short
# in-process cache. The short-lived OAuth2 access token is never stored here —
# it is cached in memory only. Migrate existing rows with scripts/migrate_secrets.py.
NUVRAIL_SECRET_BACKEND=local
# Deployment env name used in secret names/labels (e.g. dev, staging, prod):
NUVRAIL_ENV=dev
# Plaintext cache TTL (seconds) and max entries for fetched secrets:
# NUVRAIL_SECRET_CACHE_TTL=300
# NUVRAIL_SECRET_CACHE_MAX=1024

# --- AWS Secrets Manager (NUVRAIL_SECRET_BACKEND=aws-sm) --------------------
# Auth comes from the instance/task IAM role (IRSA/ECS task role) — no static keys.
# NUVRAIL_AWS_REGION=eu-west-1
# NUVRAIL_AWS_SECRET_PREFIX=nuvrail/prod        # default: nuvrail/<NUVRAIL_ENV>
# NUVRAIL_AWS_KMS_KEY_ID=                        # optional dedicated CMK
# NUVRAIL_SECRET_RECOVERY_WINDOW_DAYS=7          # soft-delete window on delete

# --- GCP Secret Manager (NUVRAIL_SECRET_BACKEND=gcp-sm) ---------------------
# Auth comes from Workload Identity / attached service account (ADC).
# NUVRAIL_GCP_PROJECT=my-project-id              # required for gcp-sm
# NUVRAIL_GCP_SECRET_PREFIX=nuvrail-prod         # default: nuvrail-<NUVRAIL_ENV>

# ---------------------------------------------------------------------------
# CORS — set to your deployed URL in production
# ---------------------------------------------------------------------------
# Comma-separated list of allowed origins (your web app's URL(s)).
# If unset, defaults to * (all origins) with a warning — fine for local dev only.
NUVRAIL_CORS_ORIGINS=https://nuvrail.example.com

# ---------------------------------------------------------------------------
# Account creation (who may create a human account on this deployment)
# ---------------------------------------------------------------------------
# NUVRAIL_SIGNUP_MODE controls the public POST /api/v1/auth/register endpoint:
#   closed  (default) → register disabled (403); provision users via
#                       scripts/manage_users.py. Unset/unknown also = closed.
#   invite            → register requires a valid single-use invite code minted
#                       via scripts/manage_invites.py (SHA-256 stored, revocable).
#   open              → anyone may self-register (also set the ack var below).
# Fail-closed: an unset/garbage value resolves to `closed` — the safe state is
# the one you get by doing nothing. See the README "Account creation (signup
# modes)" section for the full operator walkthrough.
NUVRAIL_SIGNUP_MODE=closed

# Required ACK for open mode ONLY. With NUVRAIL_SIGNUP_MODE=open the API
# REFUSES TO START unless this is truthy (1/true/yes/on) — an intended-open box
# fails loudly rather than an intended-closed box silently opening. Leave unset
# for closed/invite.
# NUVRAIL_ALLOW_OPEN_SIGNUP=1

# ---------------------------------------------------------------------------
# Proxy listen configuration
# ---------------------------------------------------------------------------
# Host/port for IMAP and SMTP proxies inside the container.
# Default values match the Dockerfile ENV — only override if you need different ports.
#
# ⚠ Keep NUVRAIL_PROXY_HOST=0.0.0.0 for the Docker Compose deploy. It looks
# like the "safe" hardening choice, but under Docker it silently breaks the
# mail path: Compose publishes the ports to the HOST loopback and forwards
# them to the CONTAINER's 0.0.0.0. Bind the proxy to 127.0.0.1 inside the
# container and the forwarded traffic lands on an address nothing listens on —
# TLS/openssl still connects (handshake terminates at docker-proxy) but the
# proxy never sees the connection and sends no IMAP/SMTP greeting. The
# container is not the security boundary here; the published-port binding
# (127.0.0.1:10143 in docker-compose.yml) is. Only use 127.0.0.1 for a
# non-containerised run.
NUVRAIL_PROXY_HOST=0.0.0.0
NUVRAIL_PROXY_IMAP_PORT=10143
NUVRAIL_PROXY_SMTP_PORT=10587

# ---------------------------------------------------------------------------
# Auth abuse protections (rate limits + lockout/backoff)
# ---------------------------------------------------------------------------
# Conservative defaults are used in code if unset.
# Tune per environment to balance protection vs. user friction.
NUVRAIL_AUTH_ATTEMPT_WINDOW_SECONDS=60
NUVRAIL_AUTH_MAX_ATTEMPTS_PER_IP=20
NUVRAIL_AUTH_MAX_ATTEMPTS_PER_ACCOUNT=10
NUVRAIL_AUTH_FAILURE_WINDOW_SECONDS=300
NUVRAIL_AUTH_MAX_FAILURES_BEFORE_LOCKOUT=5
NUVRAIL_AUTH_BASE_LOCKOUT_SECONDS=120
NUVRAIL_AUTH_MAX_LOCKOUT_SECONDS=3600

# ---------------------------------------------------------------------------
# Web Push (VAPID)
# ---------------------------------------------------------------------------
# Contact email included in VAPID push requests. Use a real address.
NUVRAIL_VAPID_EMAIL=admin@example.com

# ---------------------------------------------------------------------------
# Google OAuth2 (Gmail XOAUTH2)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the Google OAuth2 client.
# Defaults to http://localhost:8080/api/v1/oauth2/google/callback when unset.
GOOGLE_REDIRECT_URI=
NUVRAIL_HOST_EMAIL=

# ---------------------------------------------------------------------------
# Microsoft OAuth2 (Outlook.com / Office 365 XOAUTH2 via Azure AD)
# ---------------------------------------------------------------------------
# Register an app at https://portal.azure.com → App registrations. Grant the
# delegated Microsoft Graph / Office 365 Exchange Online permissions:
#   offline_access, openid, email,
#   https://outlook.office.com/IMAP.AccessAsUser.All,
#   https://outlook.office.com/SMTP.Send
# Basic auth for Exchange Online was deprecated in 2023 — OAuth2 is the only path.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the Azure AD app.
# Defaults to http://localhost:8080/api/v1/oauth2/microsoft/callback when unset.
MICROSOFT_REDIRECT_URI=
# Azure AD tenant: "common" (default) for multi-tenant + personal accounts,
# or a specific tenant GUID / domain for a single-tenant deployment.
MICROSOFT_TENANT=common

# ---------------------------------------------------------------------------
# Application behaviour
# ---------------------------------------------------------------------------
LOG_LEVEL=info
UNDO_WINDOW_HOURS=24
QUIET_HOURS_START=22
QUIET_HOURS_END=7
# ---------------------------------------------------------------------------
# E2E test credentials (never commit real values — set as GitHub Secrets)
# ---------------------------------------------------------------------------
# Used by the tests/e2e/ suite (skipped automatically when unset).
NUVRAIL_TEST_IMAP_HOST=mail.example.com
NUVRAIL_TEST_IMAP_PORT=993
NUVRAIL_TEST_IMAP_USER=you@example.com
NUVRAIL_TEST_IMAP_PASS=
NUVRAIL_TEST_SMTP_HOST=mail.example.com
NUVRAIL_TEST_SMTP_PORT=587
NUVRAIL_TEST_SMTP_USER=you@example.com
NUVRAIL_TEST_SMTP_PASS=
