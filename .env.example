# Copy to .env and fill in values. Never commit .env.
NUVRAIL_DATA_DIR=~/.nuvrail
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NUVRAIL_HOST_EMAIL=martin@animalhorde.com
LOG_LEVEL=info
UNDO_WINDOW_HOURS=24
QUIET_HOURS_START=22
QUIET_HOURS_END=7

# Master encryption key for upstream credential storage (AES-256-GCM).
# Must be exactly 64 hex characters (32 bytes).
# Generate with: python3 -c "import secrets; print(secrets.token_bytes(32).hex())"
# If unset, a key is auto-generated and saved to NUVRAIL_DATA_DIR/master.key on first run.
# WARNING: losing this key means existing encrypted credentials cannot be recovered.
# Set this explicitly for Docker/fly.io deployments — do not rely on the auto-generated file.
NUVRAIL_MASTER_KEY=
