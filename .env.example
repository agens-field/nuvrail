# Copy to .env and fill in values. Never commit .env.

# ---------------------------------------------------------------------------
# Data directory
# ---------------------------------------------------------------------------
NUVRAIL_DATA_DIR=/data

# Milliseconds a SQLite connection waits for another process's write lock
# before failing with 'database is locked'. The IMAP proxy, SMTP proxy, REST
# API, and background loops all share one SQLite file (WAL mode), so writers
# must wait rather than error. Raise if you see lock errors under heavy load.
NUVRAIL_SQLITE_BUSY_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Encryption
# ---------------------------------------------------------------------------
# Master key for AES-256-GCM upstream credential encryption.
# Must be exactly 64 hex characters (32 bytes). Required for production.
# Generate with: python3 -c "import secrets; print(secrets.token_bytes(32).hex())"
# WARNING: losing this key makes all stored upstream credentials unrecoverable.
# If unset, a key is auto-generated to NUVRAIL_DATA_DIR/master.key (dev only).
NUVRAIL_MASTER_KEY=

# ---------------------------------------------------------------------------
# CORS — set to your deployed URL in production
# ---------------------------------------------------------------------------
# Comma-separated list of allowed origins.
# test.nuvrail.com = staging; mail.nuvrail.com = production.
# If unset, defaults to * (all origins) with a warning — fine for local dev only.
NUVRAIL_CORS_ORIGINS=https://test.nuvrail.com,https://mail.nuvrail.com

# ---------------------------------------------------------------------------
# Proxy listen configuration
# ---------------------------------------------------------------------------
# Host/port for IMAP and SMTP proxies inside the container.
# Default values match the Dockerfile ENV — only override if you need different ports.
NUVRAIL_PROXY_HOST=0.0.0.0
NUVRAIL_PROXY_IMAP_PORT=10143
NUVRAIL_PROXY_SMTP_PORT=10587

# ---------------------------------------------------------------------------
# Auth abuse protections (rate limits + lockout/backoff)
# ---------------------------------------------------------------------------
# Conservative defaults are used in code if unset.
# Tune per environment to balance protection vs. user friction.
NUVRAIL_AUTH_ATTEMPT_WINDOW_SECONDS=60
NUVRAIL_AUTH_MAX_ATTEMPTS_PER_IP=20
NUVRAIL_AUTH_MAX_ATTEMPTS_PER_ACCOUNT=10
NUVRAIL_AUTH_FAILURE_WINDOW_SECONDS=300
NUVRAIL_AUTH_MAX_FAILURES_BEFORE_LOCKOUT=5
NUVRAIL_AUTH_BASE_LOCKOUT_SECONDS=120
NUVRAIL_AUTH_MAX_LOCKOUT_SECONDS=3600

# ---------------------------------------------------------------------------
# Web Push (VAPID)
# ---------------------------------------------------------------------------
# Contact email included in VAPID push requests. Use a real address.
NUVRAIL_VAPID_EMAIL=admin@nuvrail.com

# ---------------------------------------------------------------------------
# Landing page
# ---------------------------------------------------------------------------
# Loops.so API key for waitlist form submissions.
LOOPS_API_KEY=

# ---------------------------------------------------------------------------
# Google OAuth2 (Phase 0.3 — Gmail XOAUTH2)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NUVRAIL_HOST_EMAIL=

# ---------------------------------------------------------------------------
# Application behaviour
# ---------------------------------------------------------------------------
LOG_LEVEL=info
UNDO_WINDOW_HOURS=24
QUIET_HOURS_START=22
QUIET_HOURS_END=7
# ---------------------------------------------------------------------------
# E2E test credentials (never commit real values — set as GitHub Secrets)
# ---------------------------------------------------------------------------
# Used by tests/e2e/ suite and .github/workflows/e2e.yml
NUVRAIL_TEST_IMAP_HOST=blizzard.mxrouting.net
NUVRAIL_TEST_IMAP_PORT=993
NUVRAIL_TEST_IMAP_USER=testing@nuvrail.com
NUVRAIL_TEST_IMAP_PASS=
NUVRAIL_TEST_SMTP_HOST=blizzard.mxrouting.net
NUVRAIL_TEST_SMTP_PORT=587
NUVRAIL_TEST_SMTP_USER=testing@nuvrail.com
NUVRAIL_TEST_SMTP_PASS=
