# REST API base URL the web app talks to.
VITE_API_URL=http://localhost:8080

# Hostname shown to users as their IMAP/SMTP server (your deployed proxy host).
VITE_PROXY_HOST=nuvrail.example.com

# Plausible Analytics domain. Leave empty to disable analytics (the default —
# self-hosted builds send nothing unless you set this).
VITE_PLAUSIBLE_DOMAIN=

# Privacy-policy URL shown in the cookie-consent banner. Leave empty to omit
# the link.
VITE_PRIVACY_POLICY_URL=
